{% comment %}Los estilos de estas clases se definen en el <style> de cada sección que incluye este snippet.{% endcomment %}
{% # theme-check-disable ValidScopedCSSClass %}
{% if paginate.pages > 1 %}
<nav class="pagination" aria-label="Páginas de resultados">
  {% if paginate.previous %}<a href="{{ paginate.previous.url }}">Anterior</a>{% endif %}
  {% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}{% endfor %}
  {% if paginate.next %}<a href="{{ paginate.next.url }}">Siguiente</a>{% endif %}
</nav>
{% endif %}

{% # theme-check-enable ValidScopedCSSClass %}
