<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'top-banner.js' | asset_url }}" defer></script>
<store-promotions class="top-banner" role="region" aria-label="Promociones">
  <div class="swiper swiper-container">
    <div class="swiper-wrapper">
      <div class="swiper-slide">
        <p>Descuentos de invierno ahora de hasta un <strong>45% de DCTO</strong></p>
      </div>
      <div class="swiper-slide" aria-hidden="true" inert>
        <p>Renueva tus favoritos. <a href="{{ routes.all_products_collection_url }}">Explora la colección →</a></p>
      </div>
    </div>
  </div>
  {% comment %}
    Contador de promociones (inactivo). Configurar la fecha final antes de habilitarlo.
    <div class="timer_top_banner" role="timer" data-end-date="2026-12-31T23:59:59-05:00">
      <span data-days>00</span>d : <span data-hours>00</span>h :
      <span data-minutes>00</span>m : <span data-seconds>00</span>s
    </div>
  {% endcomment %}
</store-promotions>

<style>
.top-banner {
  display: block;

  flex-shrink: 0;
  min-height: 45px;
  position: relative;
  overflow: hidden;
  width: 100%;
  background: #d4ff24;
  color: #030407;
  text-align: center;
  font-weight: 600;
}
.top-banner .swiper-container {
  width: 100%;
  overflow: hidden;
}
.top-banner .swiper-wrapper {
  align-items: stretch;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}
.top-banner .swiper-slide {
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  height: auto;
  min-height: 45px;
  padding: 10px 52px;
}
.top-banner .swiper-slide > p {
  margin: 0;
  color: inherit;
  font-size: 12px;
}
.top-banner a {
  color: inherit;
  text-underline-offset: 3px;
}
.top-banner
  .swiper-container:not(.swiper-initialized)
  .swiper-slide:not(:first-child) {
  display: none;
}
.top-banner [hidden] {
  display: none;
}
@media (min-width: 767px) {
.top-banner .swiper-slide > p {
    font-size: 14px;
  }
}
</style>
