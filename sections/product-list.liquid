{% assign selected_collection = section.settings.collection | default: collections.all %}
<section class="catalog_section" aria-label="{{ section.settings.title | escape }}">
  <div class="catalog_heading">
    <h2>{{ section.settings.title | escape }}</h2>
    {% if selected_collection != blank %}
      <a href="{{ selected_collection.url }}">Ver todos</a>
    {% endif %}
  </div>
  <ul class="product_grid">
    {% for product in selected_collection.products limit: section.settings.max_products %}
      <li>{% render 'catalog-card'
, product: product
, section_id: section.id %}</li>
    {% else %}
      <li>Pronto encontrarás nuevos productos aquí.</li>
    {% endfor %}
  </ul>
</section>
<style>
  .catalog_section {
    max-width: 1440px;
    margin: auto;
    padding: 48px 32px;
    color: #f5f7fa;
  }
  .catalog_section .catalog_heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  .catalog_section .catalog_heading h2 {
    margin: 0;
    color: #f5f7fa;
    font-size: clamp(26px, 4vw, 44px);
  }
  .catalog_section .catalog_heading a {
    color: #d4ff24;
    text-underline-offset: 5px;
  }
  .catalog_section .product_grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .catalog_section .card_product {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: 10px;
    border: 1px solid #d4ff24;
    border-radius: 28px;
    background: transparent;
    color: #f5f7fa;
  }
  .catalog_section .product_image {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 20px;
    aspect-ratio: 1;
  }
  .catalog_section .product_image img,
  .catalog_section .product_image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .catalog_section .product_badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 6px 10px;
    border-radius: 6px;
    background: #d4ff24;
    color: #030407;
    font-size: 12px;
  }
  .catalog_section .product_content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
    padding: 20px 10px 10px;
  }
  .catalog_section .product_title {
    margin: 0;
    color: #f5f7fa;
    font-size: clamp(17px, 2vw, 25px);
    font-weight: 400;
    line-height: 1.25;
  }
  .catalog_section .product_title a {
    color: #f5f7fa;
    text-decoration: none;
  }
  .catalog_section .product_price {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    color: #f5f7fa;
  }
  .catalog_section .product_price strong {
    font-size: clamp(18px, 2vw, 26px);
  }
  .catalog_section .product_price s {
    color: #a1a1aa;
    font-size: 14px;
  }
  .catalog_section .product_form {
    margin-top: auto;
  }
  .catalog_section .btn_add_to__cart {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 46px;
    font-weight: 700;
    text-transform: uppercase;
    margin-top: auto;
    padding: 12px;
    border: 1px solid #1b1d1f;
    border-radius: 16px;
    background: #1b1d1f;
    color: #f5f7fa;
    font: inherit;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
  }
  .catalog_section .btn_add_to__cart:hover {
    background: #1558c9;
    border-color: #1558c9;
  }
  .catalog_section .btn_add_to__cart:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .catalog_section a:focus-visible,
  .catalog_section button:focus-visible,
  .catalog_section input:focus-visible,
  .catalog_section select:focus-visible,
  .catalog_section summary:focus-visible {
    outline: 2px solid #d4ff24;
    outline-offset: 3px;
  }
  .catalog_section .pagination {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .catalog_section .pagination a,
  .catalog_section .pagination span {
    padding: 10px;
    color: #f5f7fa;
  }
  .catalog_section .pagination [aria-current] {
    color: #d4ff24;
  }
  @media (max-width: 989px) {
    .catalog_section .product_grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }
  @media (max-width: 599px) {
    .catalog_section {
      padding: 32px 16px;
    }
    .catalog_section .product_grid {
      gap: 12px;
    }
    .catalog_section .card_product {
      padding: 6px;
      border-radius: 22px;
    }
    .catalog_section .product_image {
      border-radius: 16px;
    }
    .catalog_section .product_content {
      padding: 14px 4px 6px;
      gap: 12px;
    }
    .catalog_section .btn_add_to__cart {
      padding: 10px 6px;
      font-size: 12px;
    }
  }
</style>

{% schema %}
  {
    "name": "Lista de productos",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Título",
        "default": "Encuentra tu próximo favorito"
      }, {
        "type": "collection",
        "id": "collection",
        "label": "Colección"
      }, {
        "type": "range",
        "id": "max_products",
        "label": "Cantidad de productos",
        "min": 4,
        "max": 16,
        "step": 4,
        "default": 8
      }
    ],
    "presets": [
      {
        "name": "Lista de productos"
      }
    ]
  }
{% endschema %}
