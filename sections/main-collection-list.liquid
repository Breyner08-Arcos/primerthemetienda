<section class="collections_section">
  <h1>{{ section.settings.title | escape }}</h1>
  {% paginate collections by 24 %}
    <ul class="collections_grid">
      {% for collection in collections %}
        <li><a class="collection_card" href="{{ collection.url }}">
          {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: widths: '300, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw', loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}
          <h2>{{ collection.title | escape }}</h2><span>{{ collection.all_products_count }} productos</span>
        </a></li>
      {% else %}<li>Pronto encontrarás nuevas colecciones aquí.</li>{% endfor %}
    </ul>
    {% render 'catalog-pagination', paginate: paginate %}
  {% endpaginate %}
</section>
<style>
  .collections_section { max-width: 1440px; margin: auto; padding: 48px 32px; color: #f5f7fa; }
  .collections_section h1 { margin: 0 0 32px; color: #f5f7fa; font-size: clamp(36px, 6vw, 72px); }
  .collections_grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .collection_card { display: block; height: 100%; padding: 10px 10px 24px; border: 1px solid #d4ff24; border-radius: 28px; color: #f5f7fa; text-decoration: none; }
  .collection_card img, .collection_card svg { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 20px; }
  .collection_card h2 { margin: 20px 10px 8px; color: #f5f7fa; font-size: 24px; }
  .collection_card span { margin: 0 10px; color: #c7c9ce; }
  .collections_section a:focus-visible { outline: 2px solid #d4ff24; outline-offset: 4px; }
  .collections_section .pagination { display: flex; justify-content: center; gap: 16px; margin-top: 32px; }
  .collections_section .pagination a, .collections_section .pagination span { padding: 10px; color: #f5f7fa; }
  .collections_section .pagination [aria-current] { color: #d4ff24; }
  @media (max-width: 749px) { .collections_section { padding: 32px 16px; } .collections_grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .collection_card h2 { font-size: 18px; } }
</style>
{% schema %}
{"name":"Lista de colecciones","settings":[{"type":"text","id":"title","label":"Título","default":"Colecciones"}],"enabled_on":{"templates":["list-collections"]}}
{% endschema %}
